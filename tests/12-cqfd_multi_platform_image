#!/usr/bin/env bash
#
# validate the behavior of running a docker multi-platform image

set -o pipefail

# backup Dockefile and Cqfdfile
mv .cqfd/docker/Dockerfile .cqfd/docker/Dockerfile.orig
mv Cqfdfile Cqfdfile.orig

cp .cqfd/docker/Dockerfile.platform .cqfd/docker/Dockerfile
cp Cqfdfile-platform Cqfdfile

jtest_prepare "run cqfd with FROM --platform=linux/arm64 in Dockerfile should run linux/arm64 docker platform"
if cqfd --reinit | grep "^aarch64$"; then
	jtest_result pass
else
	jtest_result fail
fi
# restore Cqfdfile and Dockerfile
mv Cqfdfile.orig Cqfdfile
mv .cqfd/docker/Dockerfile.orig .cqfd/docker/Dockerfile

# restore container
if ! cqfd --init; then
	jtest_log error "restore container failed"
fi
