#!/usr/bin/env bash
#
# validate the behavior of cqfd with docker

set -o pipefail

# backup Cqfdfile
mv Cqfdfile Cqfdfile.orig

jtest_prepare "run cqfd with docker should use the program set in docker"
sed -e "/\[build\]/adocker='echo docker'" Cqfdfile.orig >Cqfdfile
if cqfd | grep "^docker run .* make build$"; then
	jtest_result pass
else
	jtest_result fail
fi

# restore Cqfdfile
mv Cqfdfile.orig Cqfdfile
