#!/usr/bin/env bash
#
# validate the behavior of running a docker multi-platform image

set -o pipefail

# backup Dockerfile and .cqfdrc
mv .cqfd/docker/Dockerfile .cqfd/docker/Dockerfile.orig
mv .cqfdrc .cqfdrc.orig

cp .cqfd/docker/Dockerfile.multi_platform .cqfd/docker/Dockerfile
cp cqfdrc-multi_platform .cqfdrc

native_machine=x86_64
cross_machine=aarch64
native_platform=linux/amd64
cross_platform=linux/arm64
if uname -m | grep -q "^aarch64$"; then
	native_machine=aarch64
	cross_machine=x86_64
	native_platform=linux/arm64
	cross_platform=linux/amd64
fi

jtest_prepare "run cqfd without environment CQFD_PLATFORM and option --platform should run native docker platform ($native_platform = $native_machine)"
if cqfd --reinit | grep "^$native_machine$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with environment CQFD_PLATFORM should run native docker platform ($native_platform = $native_machine)"
if env CQFD_PLATFORM="$native_platform" cqfd --reinit | grep "^$native_machine$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with option --platform should run native docker platform ($native_platform = $native_machine)"
if cqfd --platform "$native_platform" --reinit | grep "^$native_machine$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with platform should run native docker platform ($native_platform = $native_machine)"
sed -e "/\[build\]/aplatform='$native_platform'" -i .cqfdrc
if cqfd --reinit | grep "^$native_machine$"; then
	jtest_result pass
else
	jtest_result fail
fi
cp cqfdrc-multi_platform .cqfdrc

jtest_prepare "run cqfd with environment CQFD_PLATFORM should run cross docker platform ($cross_platform = $cross_machine)"
if env CQFD_PLATFORM="$cross_platform" cqfd --reinit | grep "^$cross_machine$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with option --platform should run cross docker platform ($cross_platform = $cross_machine)"
if cqfd --platform "$cross_platform" --reinit | grep "^$cross_machine$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with platform should run cross docker platform ($cross_platform = $cross_machine)"
sed -e "/\[build\]/aplatform='$cross_platform'" -i .cqfdrc
if cqfd --reinit | grep "^$cross_machine$"; then
	jtest_result pass
else
	jtest_result fail
fi
cp cqfdrc-multi_platform .cqfdrc

jtest_prepare "run cqfd docker platform helpers should run associated docker platform (linux/amd64, linux/aarch64)"
if linux-amd64-cqfd | grep "^x86_64$" && \
   linux-arm64-cqfd | grep "^aarch64$"; then
	jtest_result pass
else
	jtest_result fail
fi

# restore .cqfdrc and Dockerfile
mv .cqfdrc.orig .cqfdrc
mv .cqfd/docker/Dockerfile.orig .cqfd/docker/Dockerfile

# restore container
if ! cqfd init; then
	jtest_log error "restore container failed"
fi
