#!/usr/bin/env bash
#
# validate the behavior with erroneous usages

jtest_prepare "run cqfd with an empty command argument should fail"
if ! env CQFD_COMPAT=5 cqfd ""; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with an unknown command argument should fail"
if ! env CQFD_COMPAT=5 cqfd invalid_arg_should_fail; then
	jtest_result pass
else
	jtest_result fail
fi
