#!/usr/bin/env bash
#
# validate the behavior of cqfd with Dockerfile

set -o pipefail

# backup Dockerfile and Cqfdfile
mv .cqfd/docker/Dockerfile .cqfd/docker/Dockerfile.orig
mv Cqfdfile Cqfdfile.orig

jtest_prepare "run cqfd with ENTRYPOINT in Dockerfile should pass"
sed -e "/\[build\]/,/^$/s,^command=.*$,command='true'," Cqfdfile.orig >Cqfdfile
cat .cqfd/docker/Dockerfile.orig - <<EOF >>.cqfd/docker/Dockerfile
ENTRYPOINT ["false"]
EOF
if cqfd --reinit; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with WORKDIR in Dockerfile should pass"
sed -e "/\[build\]/,/^$/s,^command=.*$,command='pwd'," Cqfdfile.orig >Cqfdfile
cat .cqfd/docker/Dockerfile.orig - <<EOF >>.cqfd/docker/Dockerfile
WORKDIR /mnt
EOF
if cqfd --reinit | grep "^$PWD$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with USER in Dockerfile should pass"
sed -e "/\[build\]/,/^$/s,^command=.*$,command='id -un'," Cqfdfile.orig >Cqfdfile
cat .cqfd/docker/Dockerfile.orig - <<EOF >>.cqfd/docker/Dockerfile
USER nobody
EOF
if cqfd --reinit | grep "^nobody$"; then
	jtest_result pass
fi

# restore Cqfdfile and Dockerfile
mv Cqfdfile.orig Cqfdfile
mv .cqfd/docker/Dockerfile.orig .cqfd/docker/Dockerfile

# restore container
if ! cqfd init; then
	jtest_log error "restore container failed"
fi
