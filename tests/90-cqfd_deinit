#!/usr/bin/env bash
#
# validate the behavior of --deinit command

jtest_prepare "run cqfd --deinit with a Cqfdfile should pass"
if cqfd --deinit; then
	jtest_result pass
else
	jtest_result fail
fi

# backup Cqfdfile
mv Cqfdfile Cqfdfile.orig

jtest_prepare "run cqfd --deinit with a nonexistent Dockerfile should fail"
sed -e "s/\[build\]/[build]\ndistro='thisshouldfail'/" Cqfdfile.orig >Cqfdfile
if ! cqfd --deinit; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd --deinit with another Dockerfile should pass"
sed -e "s/thisshouldfail/fedora/" -i Cqfdfile
if cqfd --init && cqfd --deinit; then
	jtest_result pass
else
	jtest_result fail
fi

# restore Cqfdfile
mv Cqfdfile.orig Cqfdfile

jtest_prepare "run cqfd --deinit with an already deinit'ed image should fail"
if ! cqfd --deinit; then
	jtest_result pass
else
	jtest_result fail
fi
