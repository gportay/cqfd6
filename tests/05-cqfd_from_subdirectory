#!/usr/bin/env bash
#
# validate the behavior of cqfd from a subdirectory

set -o pipefail

# backup Cqfdfile
mv Cqfdfile Cqfdfile.orig

sed -e "/\[build\]/,/^$/s,^command=.*$,command='pwd'," Cqfdfile.orig >Cqfdfile

subdir="dir with space/b/c/d/e"
mkdir -p "$subdir"
cd "$subdir" || exit 1

jtest_prepare "run cqfd from project subdirectory containing whitespaces should pass"
if cqfd | grep "^$PWD$"; then
	jtest_result pass
else
	jtest_result fail
fi

# cleanup
cd "$OLDPWD" || exit 1

# restore Cqfdfile
mv Cqfdfile.orig Cqfdfile

# move Makefile, .cqfd and Cqfdfile
mv Makefile .cqfd Cqfdfile "$subdir"

cd "$subdir" || exit 1

jtest_prepare "run cqfd from project directory containing whitespaces should pass"
if cqfd && test -f a/cqfd_a.txt; then
	jtest_result pass
else
	jtest_result fail
fi
# cleanup
make clean

# teardown
cd "$OLDPWD" || exit 1

# moveback Cqfdfile, .cqfd and Makefile
mv "$subdir/Cqfdfile" "$subdir/.cqfd" "$subdir/Makefile" .

# cleanup
rmdir -p "$subdir"
