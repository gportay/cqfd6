#!/usr/bin/env bash
#
# validate the behavior of the skeleton bring-up

jtest_prepare "run cqfd --init without an .cqfd directory should fail"
if ! cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

mv cqfd .cqfd

jtest_prepare "run cqfd --ls without a Cqfdfile should fail"
if ! cqfd --ls; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd --gc without a Cqfdfile should fail"
if ! cqfd --gc; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd --init without a Cqfdfile should fail"
if ! cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

cp Cqfdfile-test Cqfdfile
