#!/usr/bin/env bash
#
# validate the behavior of --init command

set -o pipefail

jtest_prepare "run cqfd --init with a Cqfdfile should pass"
if cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

# backup Dockerfile
mv .cqfd/docker/Dockerfile .cqfd/docker/Dockerfile.orig

jtest_prepare "run cqfd --init without a Dockerfile should fail"
if ! cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd --init with a broken Dockerfile symlink should fail"
ln -sf Dockerfile.broken .cqfd/docker/Dockerfile
if ! cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd --init with a Dockerfile symlink should pass"
ln -sf Dockerfile.orig .cqfd/docker/Dockerfile
if cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

# restore Dockerfile
mv .cqfd/docker/Dockerfile.orig .cqfd/docker/Dockerfile

# backup Cqfdfile
mv Cqfdfile Cqfdfile.orig

jtest_prepare "run cqfd --init with a nonexistent Dockerfile should fail"
sed -e "s/\[build\]/[build]\ndistro='thisshouldfail'/" Cqfdfile.orig >Cqfdfile
if ! cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd --init with another Dockerfile should pass"
sed -e "s/thisshouldfail/fedora/" -i Cqfdfile
if cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

# restore Cqfdfile
mv Cqfdfile.orig Cqfdfile

# backup Dockerfile
mv .cqfd/docker/Dockerfile .cqfd/docker/Dockerfile.orig

jtest_prepare "run cqfd --init with same uid/gid dummy user should pass"
cat .cqfd/docker/Dockerfile.orig <<EOF >>.cqfd/docker/Dockerfile
RUN groupadd -og "${GROUPS[0]}" -f dummy && \
    useradd -s /bin/bash -ou "$UID" -g "${GROUPS[0]}" dummy
EOF
if cqfd --init; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd --init with --quiet should remain quiet"
if ! cqfd -q --init | grep -E "^(sha256:)?[a-f0-9]{64}$"; then
	jtest_result fail
else
	jtest_result pass
fi

# restore Dockerfile
mv .cqfd/docker/Dockerfile.orig .cqfd/docker/Dockerfile

# restore container
if ! cqfd --init; then
	jtest_log error "restore container failed"
fi
