#!/usr/bin/env bash
#
# validate the behavior of run with working directory

set -o pipefail

workdir="workingdir"
mkdir -p "$workdir"

# move .cqfd and Cqfdfile
mv .cqfd "$workdir/.cqfd"
mv Cqfdfile "$workdir/Cqfdfile"

cd "$workdir" || exit 1

# backup Cqfdfile
mv Cqfdfile Cqfdfile.orig

sed -e "/\[build\]/,/^$/s,^command=.*$,command='stat --printf '%u:' . ..'," Cqfdfile.orig >Cqfdfile

jtest_prepare "run cqfd without --working-directory should own working directory and should not own its parent directory"
if cqfd | grep "^$UID:0:$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with --working-directory set to inexistent directory should fail"
if ! cqfd -w "nonexistentdir"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with --working-directory set to parent directory should own parent directory and should not own its parent directory"
if cqfd -w ".." | grep "^$UID:0:$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with --working-directory set to parent directory using absolute path should own parent directory and should not own its parent directory"
if cqfd -w "$PWD/.." | grep "^$UID:0:$"; then
	jtest_result pass
else
	jtest_result fail

fi

jtest_prepare "run cqfd with CQFD_WORKDIR set to inexistent directory should fail"
if ! env CQFD_WORKDIR="nonexistentdir" cqfd; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with CQFD_WORKDIR set to parent directory should own parent directory and should not own its parent directory"
if env CQFD_WORKDIR=".." cqfd | grep "^$UID:0:$"; then
	jtest_result pass
else
	jtest_result fail

fi

jtest_prepare "run cqfd with CQFD_WORKDIR set to parent directory using absolute path should own parent directory and should not own its parent directory"
if env CQFD_WORKDIR="$PWD/.." cqfd | grep "^$UID:0:$"; then
	jtest_result pass
else
	jtest_result fail

fi

jtest_prepare "run cqfd with workdir set to inexistent directory should fail"
sed -e "/\[build\]/aworkdir='nonexistentdir'" -i Cqfdfile
if ! cqfd; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with workdir set to parent directory should own parent directory and should not own its parent directory"
sed -e "s,^workdir=.*$,workdir='..'," -i Cqfdfile
if cqfd | grep "^$UID:0:$"; then
	jtest_result pass
else
	jtest_result fail
fi

jtest_prepare "run cqfd with workdir set to parent directory using absolute path should own parent directory and should not own its parent directory"
sed -e "s,^workdir=.*$,workdir='$PWD/..'," -i Cqfdfile
if cqfd | grep "^$UID:0:$"; then
	jtest_result pass
else
	jtest_result fail
fi

# restore Cqfdfile
mv Cqfdfile.orig Cqfdfile

cd "$OLDPWD" || exit 1

# moveback Cqfdfile and .cqfd
mv "$workdir/Cqfdfile" Cqfdfile
mv "$workdir/.cqfd" .cqfd

# cleanup
rmdir -p "$workdir"
