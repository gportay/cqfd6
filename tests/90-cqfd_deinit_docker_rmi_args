#!/usr/bin/env bash
#
# validate the behavior of --deinit command with docker extra rmi arguments

jtest_prepare "run cqfd --deinit with --force set in CQFD_EXTRA_RMI_ARGS should pass"
if env CQFD_EXTRA_RMI_ARGS="--force" cqfd --deinit; then
	jtest_result pass
else
	jtest_result fail
fi

# backup .cqfdrc
mv .cqfdrc .cqfdrc.orig

jtest_prepare "run cqfd --deinit with --force set in docker_rmi_args should pass"
sed -e '/\[build\]/adocker_rmi_args="--force"' .cqfdrc.orig >.cqfdrc
if cqfd --deinit; then
	jtest_result pass
else
	jtest_result fail
fi

# restore .cqfdrc
mv .cqfdrc.orig .cqfdrc
